@page
@model SampleStore.UI.Pages.Products.DetailsModel

@section Title {@Model.Title}

<h2>@Model.Title</h2>

<div>
    <h4>Product</h4>
    <hr />
    @if (Model.Product!.PhotoId.HasValue)
    {
        <img src="@Url.Page("./Photo", new { id = Model.Product!.PhotoId })" alt="@Model.Product!.Name" style="height: 300px; width: 100%; object-fit: contain;" />
    }
    else
    {
        <div class="text-center text-muted" style="height: 300px; line-height: 300px; background-color: #f5f5f5;">
            No photo
        </div>
    }
    <dl class="dl-horizontal">
        <dt>
            @Html.DisplayNameFor(model => model.Product!.Description)
        </dt>
        <dd>
            @Html.DisplayFor(model => model.Product!.Description)
        </dd>
        <dt>
            @Html.DisplayNameFor(model => model.Product!.Name)
        </dt>
        <dd>
            @Html.DisplayFor(model => model.Product!.Name)
        </dd>
        <dt>
            @Html.DisplayNameFor(model => model.Product!.Price)
        </dt>
        <dd>
            @Html.DisplayFor(model => model.Product!.Price)
        </dd>
        <dt>
            @Html.DisplayNameFor(model => model.Product!.Quantity)
        </dt>
        <dd>
            @Html.DisplayFor(model => model.Product!.Quantity)
        </dd>
    </dl>
</div>
<div>
    <a asp-page="./Edit" asp-route-id="@Model.Product!.Id">Edit</a> |
    <a asp-page="./Index">Back to List</a>
</div>
