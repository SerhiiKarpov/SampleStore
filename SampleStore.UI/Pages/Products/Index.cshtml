@page
@model SampleStore.UI.Pages.Products.IndexModel

@section Title {@Model.Title}

<h2>@Model.Title</h2>

<p>
    <a asp-page="Create">Create New</a>
</p>

<div class="row">
@foreach (var item in Model.Products!) {
    <div class="col-sm-6 col-md-4 col-lg-3">
        <div class="thumbnail">
            @if (item.PhotoId.HasValue)
            {
                <img src="@Url.Page("./Photo", new { id = item.PhotoId })" alt="@item.Name" style="height: 200px; width: 100%; object-fit: contain;" />
            }
            else
            {
                <div class="text-center text-muted" style="height: 200px; line-height: 200px; background-color: #f5f5f5;">
                    No photo
                </div>
            }
            <div class="caption">
                <h4>@item.Name</h4>
                <p>@item.Description</p>
                <p><strong>@Html.DisplayFor(modelItem => item.Price)</strong></p>
                <p>
                    <a asp-page="./Edit" asp-route-id="@item.Id">Edit</a> |
                    <a asp-page="./Details" asp-route-id="@item.Id">Details</a> |
                    <a asp-page="./Delete" asp-route-id="@item.Id">Delete</a>
                </p>
            </div>
        </div>
    </div>
}
</div>
