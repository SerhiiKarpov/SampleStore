@page
@model IndexModel
@section Title {@Model.Title}

<h2>Featured Products</h2>

<div class="row">
    @foreach (var item in Model.Products)
    {
        <div class="col-sm-6 col-md-4 col-lg-3">
            <div class="thumbnail">
                <a asp-page="/Products/Details" asp-route-id="@item.Id">
                    @if (item.PhotoId.HasValue)
                    {
                        <img src="@Url.Page("/Products/Photo", new { id = item.PhotoId })" alt="@item.Name" style="height: 200px; width: 100%; object-fit: contain;" />
                    }
                    else
                    {
                        <div class="text-center text-muted" style="height: 200px; line-height: 200px; background-color: #f5f5f5;">
                            No photo
                        </div>
                    }
                </a>
                <div class="caption">
                    <h4>@item.Name</h4>
                    <p>@item.Description</p>
                    <p><strong>@Html.DisplayFor(modelItem => item.Price)</strong></p>
                    <p>
                        <a asp-page="/Products/Details" asp-route-id="@item.Id">Details</a>
                        @if (User.IsInRole("Admin"))
                        {
                            <text> | </text><a asp-page="/Products/Edit" asp-route-id="@item.Id">Edit</a>
                            <text> | </text><a asp-page="/Products/Delete" asp-route-id="@item.Id">Delete</a>
                        }
                    </p>
                </div>
            </div>
        </div>
    }
</div>
