{
    "ConnectionStrings": {
        "DefaultConnection": ""
    },
    "Logging": {
        "LogLevel": {
            "Default": "Warning"
        }
    },
    "AllowedHosts": "*",
    "Identity": {
        "Password": {
            "RequireDigit": true,
            "RequireLowercase": true,
            "RequireNonAlphanumeric": true,
            "RequireUppercase": true,
            "RequiredLength": 6,
            "RequiredUniqueChars": 1
        },
        "Lockout": {
            "DefaultLockoutTimeSpan": "00:05:00",
            "MaxFailedAccessAttempts": 3,
            "AllowedForNewUsers": true
        },
        "User": {
            "AllowedUserNameCharacters": "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789-._@+",
            "RequireUniqueEmail": false
        },
        "SignIn": {
            "RequireConfirmedEmail": true,
            "RequireConfirmedPhoneNumber":  false
        }
    },
    "CookieAuthentication": {
        "HttpOnly": true,
        "ExpireTimeSpan": "00:05:00",
        "LoginPath": "/Identity/Account/Login",
        "AccessDeniedPath": "/Identity/Account/AccessDenied",
        "SlidingExpiration": true
    },
    "SuperAdminPrototype": {
        "Email": "superadmin@samplestore.com",
        "FullName": "Super Admin"
    },
    "Authentication": {
        "Facebook": {
            "ClientId": "123",
            "ClientSecret": "123",
            "CallbackPath": "/identity/signin-facebook"
        },
        "Twitter": {
            "ClientId": "123",
            "ClientSecret": "123",
            "CallbackPath": "/identity/signin-twitter"
        },
        "Google": {
            "ClientId": "123",
            "ClientSecret": "123",
            "CallbackPath": "/identity/signin-google"
        },
        "Microsoft": {
            "ClientId": "123",
            "ClientSecret": "123",
            "CallbackPath":  "/identity/signin-microsoft"
        }
    },
    "EmailSender": {
        "SenderEmail": "noreply@samplestore.com"
    }
}
